# Copy this file to backend/.env and fill in real values. Never commit .env.

# Django secret key — also signs every JWT. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your_django_secret_key

# JWT lifetimes (optional — defaults shown)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# PostgreSQL — users, banks, loan policies, and saved loan requests
DB_NAME=loan_strategy_agent
DB_USER=your_postgres_user
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# Groq — the sole LLM provider (chat agent and policy extraction)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# MongoDB — persistent chat history (Atlas URI or a local instance)
MONGO_URI=your_mongodb_atlas_uri
